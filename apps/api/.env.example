# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT (change this in production!)
JWT_SECRET=super-secret-jwt-key-change-me

# CORS (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads

# OpenAI (optional - for plant identification)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0

# Web Push (optional - run: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@plantcare.local
