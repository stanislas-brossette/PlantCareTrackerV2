# PlantCareTrackerV2 API
# Minimal configuration for local development

# SQLite database used by Prisma
DATABASE_URL="file:./dev.db"

# API server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Directory where uploaded plant photos are stored
UPLOAD_DIR=./uploads

# OpenAI configuration for plant identification
# Leave OPENAI_API_KEY empty if you do not want AI identification yet
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0
