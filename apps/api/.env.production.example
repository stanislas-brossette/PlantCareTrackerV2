# PlantCareTrackerV2 API
# Example production configuration for a Raspberry Pi

# SQLite database
DATABASE_URL="file:./dev.db"

# Listen on the local network so phones/tablets can reach the server
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Uploaded images directory
UPLOAD_DIR=./uploads

# OpenAI configuration for plant identification
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0
